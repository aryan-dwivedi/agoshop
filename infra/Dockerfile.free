# Free-tier Render image: storefront edge + API + SSE + worker in one container.
# Private services, background workers, and persistent disks are not available on
# Render's free compute plan, so the paid Blueprint's topology is collapsed here.
FROM node:24-bookworm-slim AS build

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/sse-gateway/package.json apps/sse-gateway/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/search/package.json packages/search/package.json
RUN npm ci --include=dev

COPY tsconfig.base.json tsconfig.json ./
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY packages/search packages/search
COPY apps/api apps/api
COPY apps/sse-gateway apps/sse-gateway
COPY apps/worker apps/worker
COPY apps/web apps/web

RUN npm run build --workspace @shop/api \
  && npm run build --workspace @shop/sse-gateway \
  && npm run build --workspace @shop/worker

ENV VITE_SELLER_BASE_PATH=/studio
ENV VITE_SUPPORT_BASE_PATH=/support
RUN npm run build --workspace @shop/web

FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg curl ca-certificates nginx \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production
ENV MIGRATIONS_DIR=/app/apps/api/drizzle
ENV EXTRA_SQL_PATH=/app/apps/api/extra.sql
ENV RECORDING_LOCAL_DIR=/tmp/recordings
ENV PG_POOL_MAX=5
ENV NODE_OPTIONS=--max-old-space-size=256
ENV RECORDING_PROVIDER=browser

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/sse-gateway/package.json apps/sse-gateway/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/search/package.json packages/search/package.json
RUN npm ci --omit=dev

COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/sse-gateway/dist ./apps/sse-gateway/dist
COPY --from=build /app/apps/worker/dist ./apps/worker/dist
COPY apps/api/drizzle ./apps/api/drizzle
COPY apps/api/src/db/extra.sql ./apps/api/extra.sql
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY packages/search packages/search
COPY --from=build /app/apps/web/dist/customer /srv/customer
COPY --from=build /app/apps/web/dist/seller /srv/seller
COPY --from=build /app/apps/web/dist/support /srv/support
COPY infra/nginx.conf /etc/nginx/nginx.conf
COPY infra/start-free.sh /usr/local/bin/start-free.sh
RUN chmod +x /usr/local/bin/start-free.sh

EXPOSE 10000

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=6 \
  CMD ["sh", "-c", "curl -fsS http://127.0.0.1:${PORT:-10000}/api/health/live || exit 1"]

CMD ["/usr/local/bin/start-free.sh"]
