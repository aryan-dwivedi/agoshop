FROM node:24-bookworm-slim AS web-build

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --include=dev

COPY tsconfig.base.json tsconfig.json ./
COPY apps/web apps/web
COPY packages/shared packages/shared

ENV VITE_SELLER_BASE_PATH=/studio
ENV VITE_SUPPORT_BASE_PATH=/support
RUN npm run build --workspace @shop/web

FROM caddy:2.10.2-alpine

COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=web-build /app/apps/web/dist/customer /srv/customer
COPY --from=web-build /app/apps/web/dist/seller /srv/seller
COPY --from=web-build /app/apps/web/dist/support /srv/support

EXPOSE 10000
