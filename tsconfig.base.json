{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": false,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["node"],
        "paths": {
            "@shop/db": ["./packages/db/src/index.ts"],
            "@shop/db/*": ["./packages/db/src/*"],
            "@shop/platform": ["./packages/platform/src/index.ts"],
            "@shop/platform/*": ["./packages/platform/src/*"],
            "@shop/agora": ["./packages/agora/src/index.ts"],
            "@shop/agora/*": ["./packages/agora/src/*"],
            "@shop/ai": ["./packages/ai/src/index.ts"],
            "@shop/ai/*": ["./packages/ai/src/*"],
            "@shop/api/*": ["./apps/api/src/*"],
            "@shop/search": ["./packages/search/src/index.ts"],
            "@shop/search/*": ["./packages/search/src/*"],
            "@shop/domain-commerce": ["./packages/domain-commerce/src/index.ts"],
            "@shop/domain-commerce/*": ["./packages/domain-commerce/src/*"],
            "@shop/domain-live": ["./packages/domain-live/src/index.ts"],
            "@shop/domain-live/*": ["./packages/domain-live/src/*"],
            "@shop/shared": ["./packages/shared/src/index.ts"],
            "@shop/shared/*": ["./packages/shared/src/*"],
            "@shop/worker/*": ["./apps/worker/src/*"],
            "@shop/ai-service/*": ["./apps/ai-service/src/*"]
        },
        "baseUrl": "."
    },
    "files": ["./packages/platform/src/types/express.d.ts"]
}
