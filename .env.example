# Copy to .env and fill in values before `npm run dev`.
#
# Local dev: PostgreSQL + Redis must be running at DATABASE_URL / REDIS_URL.
# Voice AI: Agora must reach PUBLIC_API_URL/mcp — use an ngrok URL here when
# developing on localhost (e.g. `ngrok http 8787`). On Render, this is set
# automatically from RENDER_EXTERNAL_URL.

NODE_ENV=development
PORT=8787
PUBLIC_API_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
DATABASE_URL=postgres://localhost:5432/live_commerce
REDIS_URL=redis://127.0.0.1:6379
SESSION_COOKIE_SECRET=change-me-to-32-random-bytes-min

# Agora (App ID + Certificate required; Customer ID + Secret required for ConvoAI / RTT)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# Optional: published Agora Studio agent ID (Console → Agents → Embed Agent → pipeline_id).
# When set, voice uses the Console agent as-is (ASR/LLM/TTS/MCP/prompt all from Studio).
# The API only supplies the RTC channel, token, and participant UIDs at join time.
# AGORA_STUDIO_PIPELINE_ID=

# MCP tool-call HMAC (min 16 chars; must match across all API / AI replicas)
CONVO_LLM_SHARED_SECRET=change-me-to-32-random-bytes-min

# Optional: static Bearer for Agora Console MCP (Streamable HTTP → /mcp).
# Console → Integrations → MCP → Headers (required for connection test to pass):
#   Authorization: Bearer <MCP_STATIC_API_KEY>
# Set the same value in Render env. Live tool calls still need X-Convo-Id (injected at voice join).
# MCP_SERVER_NAME must match the Console MCP server identifier (letters/numbers only).
# MCP_STATIC_API_KEY=
# MCP_SERVER_NAME=shop

# Optional: Agora webhook signature verification (leave empty to ignore webhooks)
# AGORA_WEBHOOK_SECRET=

# Media / recording (defaults shown — override only when needed)
MEDIA_GATEWAY_ENABLED=true
MEDIA_GATEWAY_REGION=ap
RECORDING_PROVIDER=browser
TRANSCRIPTION_PROVIDER=agora
TRANSCRIPTION_LANGUAGES=en-US

# Optional: real text-chat LLM (voice uses Agora managed LLM + MCP; defaults to mock)
# LLM_PROVIDER=openrouter
# LLM_API_KEY=

# Docker Compose only (infra/docker-compose.yml)
# POSTGRES_PASSWORD=postgres
