    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2"
  }
}
