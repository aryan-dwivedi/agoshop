{
    "name": "@shop/api",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "exports": {
        "./app": "./src/app.ts",
        "./app.js": "./src/app.ts",
        "./routes/*": "./src/routes/*"
    },
    "//": "Every entry point loads the repo-root .env explicitly: env.ts refuses to boot on invalid config, so a script that forgets --env-file fails instead of silently using defaults.",
    "scripts": {
        "dev": "node --env-file=../../.env --import tsx --watch src/index.ts",
        "dev:background": "npm run dev --workspace @shop/worker",
        "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js && esbuild src/db/push.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/db-push.js && esbuild src/db/seed.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/db-seed.js",
        "start": "node --env-file=../../.env dist/index.js",
        "start:dev": "node --env-file=../../.env --import tsx src/index.ts",
        "start:background": "npm run start --workspace @shop/worker",
        "db:push": "node --env-file=../../.env --import tsx src/db/push.ts",
        "db:seed": "node --env-file=../../.env --import tsx src/db/seed.ts",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "@shop/agora": "*",
        "@shop/ai": "*",
        "@shop/db": "*",
        "@shop/domain-commerce": "*",
        "@shop/domain-live": "*",
        "@shop/platform": "*",
        "@shop/search": "*",
        "@shop/shared": "*",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.5",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csv-parse": "^7.0.2",
        "drizzle-orm": "^0.38.3",
        "express": "^5.0.1",
        "multer": "^2.3.0",
        "pg": "^8.13.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/multer": "^1.4.12",
        "@types/pg": "^8.11.10",
        "@types/supertest": "^6.0.2",
        "drizzle-kit": "^0.30.1",
        "esbuild": "^0.25.0",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2"
    }
}
